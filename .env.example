# CreatorIQ — Environment Variables Template
# Copy this file to .env and configure local/production values.
# Do NOT commit actual secrets to version control.

# Application & Auth
SECRET_KEY=
DATABASE_URL=
FRONTEND_URL=

# YouTube Data API v3 & YouTube Analytics
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REDIRECT_URI=

# Instagram Integration (RapidAPI — Glavier Instagram API)
RAPIDAPI_KEY=
RAPIDAPI_HOST=instagram-bulk-profile-scrapper.p.rapidapi.com

# Facebook Graph API
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_REDIRECT_URI=

# X (Twitter) Developer API v2
X_CLIENT_ID=
X_CLIENT_SECRET=
X_API_KEY=
X_API_SECRET=
X_REDIRECT_URI=

# LinkedIn Community Management API
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=
